NEXT_PUBLIC_STOCKR_HOST=stockr.currentflowconsulting.org
NEXT_PUBLIC_APP_URL=https://stockr.currentflowconsulting.org
# Set automatically on GitHub deploy. Local/dev stays empty so the update popup stays off.
# NEXT_PUBLIC_STOCKR_BUILD_SHA=
# Optional. Defaults to the Play URL for org.currentflowconsulting.stockr
# NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=org.currentflowconsulting.stockr

# Stockr's own Supabase project — not NECalcul8r or The Truth.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STOCKR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Stripe Checkout for PWA / web. Production refuses paid upgrades if these are missing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_FLEET=
# RESEND_API_KEY=
# RESEND_FROM=Stockr <stockr@currentflowconsulting.org>

# Google Play Billing (Android package org.currentflowconsulting.stockr)
NEXT_PUBLIC_PLAY_PRODUCT_PRO=stockr_pro
NEXT_PUBLIC_PLAY_PRODUCT_FLEET=stockr_fleet
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Preview only. Ignored on Cloudflare/Vercel production.
# GOOGLE_PLAY_ALLOW_UNVERIFIED=1
# STOCKR_ALLOW_MOCK_BILLING=1
# STOCKR_ENABLE_DEMO=1
# NEXT_PUBLIC_STOCKR_DEMO=1
# PLATFORM_OWNER_PASSWORD=

# Buildr project sync (sister app at buildrpm.com — api.buildr.app does not resolve)
BUILDR_API_URL=https://buildrpm.com
BUILDR_API_KEY=
# Same HMAC secret Buildr uses to launch Stockr already signed in.
# FAMILY_APP_SSO_SECRET=

# Optional. Unknown barcode ID uses Open Facts + UPCitemdb trial (100/day) without a key.
# UPCITEMDB_API_KEY=
# GO_UPC_API_KEY=
# Camera photo ID uses the stockr-vision Worker (Workers AI) to name the object
# and produce a barcode. Deploy sets STOCKR_VISION_URL and STOCKR_VISION_SECRET.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# STOCKR_VISION_URL=
# STOCKR_VISION_SECRET=
# Optional higher-quality vision:
# OPENAI_API_KEY=
# GEMINI_API_KEY=
