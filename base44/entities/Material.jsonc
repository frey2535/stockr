{
  "name": "Material",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Tenant/company ID for multi-tenant scoping"
    },
    "barcode": {
      "type": "string",
      "description": "Barcode or UPC of the material"
    },
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "description": {
      "type": "string",
      "description": "Product description"
    },
    "manufacturer": {
      "type": "string",
      "description": "Manufacturer/brand name"
    },
    "supplier": {
      "type": "string",
      "description": "Supplier name"
    },
    "category": {
      "type": "string",
      "description": "Material category (e.g. Conduit, Wire, Fittings)"
    },
    "sub_category": {
      "type": "string",
      "description": "Material sub-category (e.g. EMT Connectors, EMT Raceway, Rigid Couplings)"
    },
    "item_type": {
      "type": "string",
      "description": "3rd level classification (e.g. Set Screw, Compression, LB, LL, 1/2\", 3/4\")"
    },
    "unit": {
      "type": "string",
      "description": "Unit of measurement (e.g. each, ft, box)"
    },
    "unit_cost": {
      "type": "number",
      "description": "Cost per unit"
    },
    "reorder_point": {
      "type": "number",
      "description": "Reorder trigger \u2014 when total on-hand quantity falls at or below this value, the material is flagged for reorder"
    },
    "min_stock_level": {
      "type": "number",
      "description": "Safety stock floor \u2014 when total on-hand quantity falls at or below this value, the material is flagged as critical"
    },
    "image_url": {
      "type": "string",
      "description": "Product image URL"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Alternate names, common misspellings, or short-form keywords for search"
    }
  },
  "required": [
    "name"
  ]
}