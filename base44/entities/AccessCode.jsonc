{
  "name": "AccessCode",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Tenant/company ID for multi-tenant scoping"
    },
    "code": {
      "type": "string",
      "description": "The access code string"
    },
    "type": {
      "type": "string",
      "enum": [
        "trial",
        "permanent"
      ],
      "description": "Trial (time-limited) or permanent access"
    },
    "label": {
      "type": "string",
      "description": "Label for this code, e.g. contractor name or company"
    },
    "expires_at": {
      "type": "string",
      "format": "date",
      "description": "Expiry date for trial codes"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this code is currently active"
    },
    "used_by": {
      "type": "string",
      "description": "Email of the user who redeemed this code"
    },
    "used_at": {
      "type": "string",
      "description": "Timestamp when the code was redeemed"
    }
  },
  "required": [
    "code",
    "type"
  ]
}