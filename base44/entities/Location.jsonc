{
  "name": "Location",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Tenant/company ID for multi-tenant scoping"
    },
    "name": {
      "type": "string",
      "description": "Name of the location (e.g. Main Warehouse, Truck #1)"
    },
    "type": {
      "type": "string",
      "enum": [
        "warehouse",
        "vehicle"
      ],
      "description": "Type of location"
    },
    "description": {
      "type": "string",
      "description": "Additional details about the location"
    },
    "assigned_to": {
      "type": "string",
      "description": "Person assigned to this vehicle/location"
    }
  },
  "required": [
    "name",
    "type"
  ]
}