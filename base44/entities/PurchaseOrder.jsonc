{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string",
      "description": "Tenant/company ID for multi-tenant scoping"
    },
    "po_number": {
      "type": "string",
      "description": "Purchase order number (from supplier or internal)"
    },
    "supplier": {
      "type": "string",
      "description": "Supplier name"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ordered",
        "partial",
        "received",
        "cancelled"
      ],
      "default": "ordered",
      "description": "PO status: draft, ordered (sent to supplier), partial (some received), received (complete), cancelled"
    },
    "expected_delivery_date": {
      "type": "string",
      "format": "date",
      "description": "Expected delivery date"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "material_id": {
            "type": "string",
            "description": "Reference to Material entity"
          },
          "material_name": {
            "type": "string",
            "description": "Snapshot of material name at PO creation"
          },
          "expected_quantity": {
            "type": "number",
            "description": "Quantity ordered from supplier"
          },
          "received_quantity": {
            "type": "number",
            "default": 0,
            "description": "Quantity received so far"
          },
          "unit_cost": {
            "type": "number",
            "description": "Cost per unit from supplier"
          }
        },
        "required": [
          "material_id",
          "expected_quantity"
        ]
      },
      "description": "Line items on this PO"
    }
  },
  "required": [
    "po_number"
  ]
}