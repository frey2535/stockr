{
  "name": "Buildr Sync - Transaction Delete",
  "description": "",
  "trigger": {
    "condition": "${ ((.trigger.data.type == \"use\") and (.trigger.data.buildr_expense_id != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "delete"
      ],
      "entity_name": "Transaction"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "buildr_sync_transaction_delete",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncTransactionToBuildr",
            "args": {
              "operation": "delete"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncTransactionToBuildr"
  }
}